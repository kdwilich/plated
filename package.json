		"@types/node": "^26.2.0",
		"sass": "^1.99.0",
		"sharp": "^0.35.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.80.0"
	},
	"dependencies": {
		"@fontsource/barlow-condensed": "^5.2.5"
